/* 购物车样式 */
.cart-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999;
}

.cart-empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  background: #ffffff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 32rpx;
  color: #c8590d;
  font-weight: bold;
}

.item-quantity {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f0f0f0;
  border-radius: 50%;
  font-size: 32rpx;
}

.qty-num {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 0 10rpx;
}

.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.total {
  font-size: 32rpx;
  color: #333;
}

.checkout-btn {
  background: #c8590d;
  color: #ffffff;
  border-radius: 50rpx;
  padding: 16rpx 60rpx;
  font-size: 32rpx;
}
