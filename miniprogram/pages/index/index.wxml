<view class="page">
  <!-- 搜索 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索非遗好物,如:银饰" confirm-type="search"
      bindinput="onKeyword" bindconfirm="doSearch" value="{{keyword}}" />
    <view class="search-btn" bindtap="doSearch">搜索</view>
  </view>

  <!-- 轮播图 -->
  <swiper wx:if="{{banners.length}}" class="banner" indicator-dots autoplay circular
    indicator-color="rgba(255,255,255,.6)" indicator-active-color="#fff">
    <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="goBanner" data-item="{{item}}">
      <image class="banner-img" src="{{item.image}}" mode="aspectFill" />
      <view class="banner-title">{{item.title}}</view>
    </swiper-item>
  </swiper>

  <!-- 金刚区:分类快捷入口 -->
  <view class="grid-nav" wx:if="{{categories.length}}">
    <view class="nav-cell" wx:for="{{categories}}" wx:key="id" bindtap="setCat" data-id="{{item.id}}">
      <view class="nav-icon" style="background: {{navColors[item.id % navColors.length]}}">{{item.name[0]}}</view>
      <view class="nav-name">{{item.name}}</view>
    </view>
    <view class="nav-cell" bindtap="setCat" data-id="0">
      <view class="nav-icon all">全</view>
      <view class="nav-name">全部</view>
    </view>
  </view>

  <!-- 热卖推荐 -->
  <view class="hot-title" wx:if="{{hotList.length}}">🔥 热卖推荐</view>
  <view class="hot-scroll" wx:if="{{hotList.length}}">
    <view class="hot-card" wx:for="{{hotList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="hot-img" src="{{item.main_image}}" mode="aspectFill" />
      <view class="hot-name">{{item.title}}</view>
      <view class="hot-foot">
        <text class="hot-price">¥{{item.price}}</text>
        <text class="hot-sales">已售{{item.sales}}</text>
      </view>
    </view>
  </view>

  <!-- 分类筛选 -->
  <view class="sorts">
    <view class="sort {{query.sort === 'time' ? 'on' : ''}}" bindtap="setSort" data-sort="time">最新</view>
    <view class="sort {{query.sort === 'sales' ? 'on' : ''}}" bindtap="setSort" data-sort="sales">销量</view>
    <view class="sort {{query.sort === 'price' ? 'on' : ''}}" bindtap="setSort" data-sort="price">价格</view>
  </view>

  <!-- 商品列表 -->
  <view class="grid" wx:if="{{list.length}}">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="img" src="{{item.main_image}}" mode="aspectFill" />
      <view class="info">
        <view class="title">{{item.title}}</view>
        <view class="sub">{{item.subtitle || '非遗手工 · 匠心之作'}}</view>
        <view class="foot">
          <text class="price">¥{{item.price}}</text>
          <text class="sales" wx:if="{{item.sales}}">已售{{item.sales}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="empty" wx:else>
    <view class="empty-icon">🈳</view>
    <view>暂无商品</view>
  </view>

  <view class="load-more" bindtap="loadMore">加载更多</view>
</view>
