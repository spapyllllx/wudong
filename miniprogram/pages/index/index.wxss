.page {
  padding-bottom: 40rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #8e2f2f;
  position: sticky;
  top: 0;
  z-index: 5;
}
.search-input {
  flex: 1;
  background: #fff;
  border-radius: 32rpx;
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.search-btn {
  color: #fff;
  margin-left: 20rpx;
  font-size: 28rpx;
}
.cats {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 0;
}
.cat {
  display: inline-flex;
  padding: 8rpx 28rpx;
  margin: 0 8rpx;
  border-radius: 28rpx;
  background: #f2f3f5;
  font-size: 26rpx;
}
.cat.on {
  background: #8e2f2f;
  color: #fff;
}
.sorts {
  display: flex;
  background: #fff;
  padding: 14rpx 24rpx;
  margin-top: 16rpx;
}
.sort {
  margin-right: 40rpx;
  font-size: 26rpx;
  color: #666;
}
.sort.on {
  color: #8e2f2f;
  font-weight: 600;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 16rpx 12rpx 0;
}
.card {
  width: 356rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.img {
  width: 100%;
  height: 300rpx;
  background: #f2f3f5;
}
.info {
  padding: 16rpx;
}
.title {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sub {
  font-size: 22rpx;
  color: #999;
  margin: 6rpx 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.price {
  color: #e54d42;
  font-size: 32rpx;
  font-weight: 700;
}
.sales {
  font-size: 22rpx;
  color: #999;
}
.rate {
  font-size: 22rpx;
  color: #e6a23c;
  margin-top: 4rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 28rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.load-more {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 20rpx;
}
