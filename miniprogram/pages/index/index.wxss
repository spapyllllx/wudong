.page {
  padding-bottom: 40rpx;
}
.banner {
  height: 320rpx;
}
.banner-img {
  width: 100%;
  height: 320rpx;
}
.banner-title {
  position: absolute;
  left: 24rpx;
  bottom: 40rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}
.grid-nav {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  margin-top: 16rpx;
}
.nav-cell {
  flex: 1;
  text-align: center;
}
.nav-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 auto 8rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}
.nav-icon.all {
  background: linear-gradient(135deg, #8e2f2f, #b5453a);
}
.nav-name {
  font-size: 24rpx;
  color: #333;
}
.hot-title {
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 24rpx 0;
}
.hot-scroll {
  display: flex;
  overflow-x: auto;
  padding: 20rpx 24rpx;
}
.hot-card {
  flex: none;
  width: 220rpx;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.hot-img {
  width: 220rpx;
  height: 170rpx;
  background: #f2f3f5;
}
.hot-name {
  font-size: 24rpx;
  padding: 8rpx 12rpx 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hot-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 6rpx 12rpx 12rpx;
}
.hot-price {
  color: #e54d42;
  font-weight: 700;
}
.hot-sales {
  font-size: 20rpx;
  color: #999;
}
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #8e2f2f;
  position: sticky;
  top: 0;
  z-index: 5;
}
.search-input {
  flex: 1;
  background: #fff;
  border-radius: 32rpx;
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.search-btn {
  color: #fff;
  margin-left: 20rpx;
  font-size: 28rpx;
}
.cats {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 0;
}
.cat {
  display: inline-flex;
  padding: 8rpx 28rpx;
  margin: 0 8rpx;
  border-radius: 28rpx;
  background: #f2f3f5;
  font-size: 26rpx;
}
.cat.on {
  background: #8e2f2f;
  color: #fff;
}
.sorts {
  display: flex;
  background: #fff;
  padding: 14rpx 24rpx;
  margin-top: 16rpx;
}
.sort {
  margin-right: 40rpx;
  font-size: 26rpx;
  color: #666;
}
.sort.on {
  color: #8e2f2f;
  font-weight: 600;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 16rpx 12rpx 0;
}
.card {
  width: 356rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.img {
  width: 100%;
  height: 300rpx;
  background: #f2f3f5;
}
.info {
  padding: 16rpx;
}
.title {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sub {
  font-size: 22rpx;
  color: #999;
  margin: 6rpx 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.price {
  color: #e54d42;
  font-size: 32rpx;
  font-weight: 700;
}
.sales {
  font-size: 22rpx;
  color: #999;
}
.rate {
  font-size: 22rpx;
  color: #e6a23c;
  margin-top: 4rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 28rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.load-more {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 20rpx;
}
