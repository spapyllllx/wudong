/* app.wxss - 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

/* 通用样式 */
.container {
  padding: 20rpx;
}

/* 按钮样式 */
.btn-primary {
  background-color: #c8590d;
  color: #ffffff;
  border-radius: 8rpx;
}

.btn-primary:active {
  background-color: #a8470a;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 文本样式 */
.text-primary {
  color: #c8590d;
}

.text-secondary {
  color: #999999;
}

.text-muted {
  color: #cccccc;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #eeeeee;
  margin: 20rpx 0;
}

/* 价格样式 */
.price {
  color: #c8590d;
  font-weight: bold;
}

.price::before {
  content: "¥";
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}
