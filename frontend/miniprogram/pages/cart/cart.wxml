<!--购物车-->
<view class="cart-container">
  <view class="cart-empty" wx:if="{{cartList.length === 0}}">
    <image src="/static/images/empty-cart.png" mode="aspectFit"></image>
    <text>购物车是空的</text>
  </view>
  
  <view class="cart-list" wx:else>
    <view class="cart-item" wx:for="{{cartList}}" wx:key="id">
      <image src="{{item.mainImage}}" class="item-img" />
      <view class="item-info">
        <text class="item-name">{{item.title}}</text>
        <text class="item-spec">{{item.specName}}</text>
        <view class="item-bottom">
          <text class="item-price">¥{{item.price}}</text>
          <view class="item-quantity">
            <text class="qty-btn" bindtap="decreaseQty" data-index="{{index}}">-</text>
            <text class="qty-num">{{item.quantity}}</text>
            <text class="qty-btn" bindtap="increaseQty" data-index="{{index}}">+</text>
          </view>
        </view>
      </view>
    </view>
    
    <view class="cart-footer">
      <text class="total">合计: ¥{{totalAmount}}</text>
      <button class="checkout-btn" bindtap="checkout">去结算({{totalCount}})</button>
    </view>
  </view>
</view>
