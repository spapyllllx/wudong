<!--个人中心-->
<view class="profile-container">
  <!-- 用户信息 -->
  <view class="user-info" wx:if="{{userInfo}}">
    <image class="avatar" src="{{userInfo.avatar || '/static/images/default-avatar.png'}}"></image>
    <view class="user-detail">
      <text class="nickname">{{userInfo.nickname || userInfo.phone}}</text>
      <text class="phone">{{userInfo.phone}}</text>
    </view>
  </view>
  
  <!-- 未登录状态 -->
  <view class="login-prompt" wx:else>
    <button bindtap="login" class="btn-login">登录/注册</button>
  </view>

  <!-- 功能入口 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToOrders">
      <text>我的订单</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToCart">
      <text>购物车</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToFavorites">
      <text>我的收藏</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToAddresses">
      <text>收货地址</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToMessages">
      <text>消息通知</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>
