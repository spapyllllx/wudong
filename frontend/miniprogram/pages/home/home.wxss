/* 首页样式 */
.banner {
  width: 100%;
  height: 320rpx;
}

.banner image {
  width: 100%;
  height: 320rpx;
}

.nav-grid {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  padding: 30rpx 0;
  margin: 20rpx 0;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-item image {
  width: 80rpx;
  height: 80rpx;
}

.nav-item text {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #333333;
}

.section {
  background: #ffffff;
  padding: 20rpx;
  margin: 20rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.recommend-scroll {
  white-space: nowrap;
}

.recommend-item {
  display: inline-block;
  width: 240rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.recommend-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 12rpx;
}

.recommend-name {
  font-size: 26rpx;
  color: #333333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 10rpx;
}

.recommend-price {
  font-size: 28rpx;
  color: #c8590d;
  font-weight: bold;
  display: block;
  margin-top: 8rpx;
}

.notice-bar {
  background: #fff7e6;
  padding: 20rpx;
  margin: 20rpx 0;
  font-size: 26rpx;
  color: #c8590d;
}
