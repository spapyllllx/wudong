<!--我的订单-->
<view class="orders-container">
  <view class="order-tabs">
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">全部</view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">待支付</view>
    <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-index="2">待确认</view>
    <view class="tab-item {{currentTab === 3 ? 'active' : ''}}" bindtap="switchTab" data-index="3">已完成</view>
  </view>

  <view class="order-list" wx:if="{{orderList.length > 0}}">
    <view class="order-item" wx:for="{{orderList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>
      <view class="order-body">
        <image src="{{item.mainImage}}" class="order-img" />
        <view class="order-info">
          <text class="order-title">{{item.title}}</text>
          <text class="order-time">{{item.createTime}}</text>
        </view>
        <text class="order-amount">¥{{item.payAmount}}</text>
      </view>
      <view class="order-actions">
        <button wx:if="{{item.status === 0}}" class="btn-cancel" size="mini" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
        <button wx:if="{{item.status === 0}}" class="btn-pay" size="mini" bindtap="goToPay" data-id="{{item.id}}">去支付</button>
        <button wx:if="{{item.status === 1}}" class="btn-confirm" size="mini">确认收货</button>
      </view>
    </view>
  </view>

  <view class="empty-order" wx:else>
    <image src="/static/images/empty-order.png" mode="aspectFit"></image>
    <text>暂无订单</text>
  </view>
</view>
